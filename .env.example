# Copy to .env and adjust. All values have sane defaults — you usually don't
# need a .env file at all for local dev.

# App
APP_NAME=StreamSnap
DEBUG=false

# Database — SQLite file path (async / aiosqlite URL)
DB_URL=sqlite+aiosqlite:///./streamsnap.db

# Where finished downloads are written
DOWNLOAD_DIR=./downloads

# Isolated yt-dlp install dir. Empty = use the system/venv yt-dlp.
# In Docker this is set to /ytdlp (a named volume) so in-app updates persist.
YTDLP_DIR=

# Legacy — concurrency is set in the UI (Settings -> Download). Ignored otherwise.
MAX_CONCURRENT_DOWNLOADS=1

# Cross-origin clients allowed to connect (REST + WebSocket). Empty = allow any
# origin, which is fine for a private-network, single-user deployment. Restrict
# it when the instance is reachable from an untrusted network, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://nas.local:8088
CORS_ORIGINS=
